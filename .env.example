# ─── Serveur ───────────────────────────────────────────────
PORT=8080
DATABASE_URL=sqlite://data/workeo.db

# Secret de signature des JWT (à changer en production)
JWT_SECRET=change-me-in-production

# ─── IA (LLM) ──────────────────────────────────────────────
# ollama : IA locale (recommandé, gratuit)  |  openai : API compatible OpenAI  |  none : heuristiques
LLM_PROVIDER=ollama

# Ollama (https://ollama.com)  ->  ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Compatible OpenAI (OpenAI, Groq, Together, Azure, LM Studio...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Scraping ──────────────────────────────────────────────
# Délai max par source (secondes)
SCRAPE_TIMEOUT_SECS=15
# Sources activées par défaut (séparées par des virgules)
# arbeitnow,remotive,remoteok,demo
SCRAPE_SOURCES=arbeitnow,remotive,remoteok,demo
