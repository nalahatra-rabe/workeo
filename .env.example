# ─── Serveur ───────────────────────────────────────────────
PORT=8080
DATABASE_URL=sqlite://data/workeo.db

# Secret de signature des JWT (à changer impérativement en production)
JWT_SECRET=change-me-in-production

# ─── IA (LLM) ──────────────────────────────────────────────
# ollama : IA locale (recommandé, gratuit)  |  openai : API compatible OpenAI  |  none : heuristiques
LLM_PROVIDER=ollama

# Ollama (https://ollama.com)  ->  ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Compatible OpenAI (OpenAI, Groq, Together, Azure, LM Studio...)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Scraping ──────────────────────────────────────────────
# Délai max par source (secondes)
SCRAPE_TIMEOUT_SECS=15
# Sources activées par défaut (séparées par des virgules).
# Disponibles : arbeitnow, remotive, remoteok, jobicy, himalayas, weworkremotely,
#               portaljob_mg, tanitjobs, linkedin, wttj, hellowork, adzuna, jooble
SCRAPE_SOURCES=arbeitnow,remotive,remoteok,jobicy,himalayas,weworkremotely,portaljob_mg,wttj,hellowork,linkedin,tanitjobs

# ─── Sources nécessitant une clé API (optionnelles) ────────
# Adzuna — https://developer.adzuna.com  (pays : fr, gb, us, de, es, it, ca... ; pas Madagascar)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
# Jooble — https://jooble.org/api/about
JOOBLE_API_KEY=
